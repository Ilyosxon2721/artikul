includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database/factories
        - database/seeders
        - routes

    level: 6

    excludePaths:
        - app/Console/Kernel.php
        - app/Exceptions/Handler.php

    ignoreErrors:
        - '#PHPDoc tag @var#'

    checkMissingIterableValueType: false
    treatPhpDocTypesAsCertain: false
